{
  "name": "@open-slot-ui/silk",
  "version": "0.14.0",
  "description": "Canvas view + controller binding for open-ui \u2014 the same HUD as the DOM binding, drawn with pixi-silk on a PixiJS stage instead of markup and CSS.",
  "keywords": [
    "slot",
    "slots",
    "igaming",
    "casino",
    "game-ui",
    "hud",
    "pixi",
    "pixi-silk",
    "canvas",
    "typescript"
  ],
  "license": "MIT",
  "author": "schmooky and the open-ui contributors",
  "homepage": "https://github.com/schmooky/open-slot-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/schmooky/open-slot-ui.git",
    "directory": "packages/silk"
  },
  "bugs": {
    "url": "https://github.com/schmooky/open-slot-ui/issues"
  },
  "type": "module",
  "sideEffects": false,
  "source": "./src/index.ts",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "extract-skin": "node scripts/extract-skin.mjs",
    "capture": "node scripts/capture.mjs",
    "parity": "node scripts/parity.mjs",
    "doors": "node scripts/click-through.mjs"
  },
  "dependencies": {
    "@open-slot-ui/core": "workspace:*"
  },
  "peerDependencies": {
    "pixi-silk": "^0.1.0",
    "pixi.js": "^8.6.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.0",
    "pixi-silk": "^0.1.0",
    "pixi.js": "^8.6.6",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
